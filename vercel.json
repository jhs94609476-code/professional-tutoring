{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/public/sitemap.xml" },
    { "source": "/rss.xml", "destination": "/public/rss.xml" },
    { "source": "/main.css", "destination": "/public/main.css" },
    { "source": "/router.js", "destination": "/public/router.js" },
    { "source": "/images/:path*", "destination": "/public/images/:path*" },
    { "source": "/:path*", "destination": "/public/:path*" }
  ]
}
